{
  "expo": {
    "name": "InsightScoop",
    "slug": "insightscoop",
    "owner": "yardura",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "insightscoop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo-stacked.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yardura.insightscoop.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "minimumOSVersion": "14.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to capture stool samples for wellness insights.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to track walks and verify on-site visits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow background location access to detect walks and send wellness prompts.",
        "NSLocationAlwaysUsageDescription": "Allow background location access to detect walks and send wellness prompts.",
        "NSMicrophoneUsageDescription": "Allow microphone access to record visit notes for sales follow-ups.",
        "NSPhotoLibraryUsageDescription": "Allow access to upload vet notes for wellness check-ins.",
        "NSUserTrackingUsageDescription": "This identifier will be used to personalize ads and improve your experience.",
        "UIBackgroundModes": ["location"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yardura.insightscoop.app",
      "googleServicesFile": "./google-services.json",
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-1024.png",
        "backgroundColor": "#F8FAFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-camera",
      "expo-location",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-tracking-transparency",
      "./plugins/withNativeShutter.js"
    ],
    "extra": {
      "apiBaseUrl": "https://www.getinsightscoop.com",
      "router": {},
      "eas": {
        "projectId": "ae291f80-e3b3-488c-91be-b84c33f6a592"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
