// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User accounts with authentication
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  // Password reset fields
  reset_token         String?
  reset_token_expires DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  address          String?
  city             String?
  zipCode          String?
  role             UserRole  @default(CUSTOMER)
  roles            UserRole[] @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  stripeCustomerId String?
  stripeConnectAccountId String?
  pushNotificationsEnabled Boolean @default(true)

  // OAuth provider IDs for Sign in with Apple/Google
  appleId          String?   @unique

  // Sales rep specific fields
  salesRepId     String? // ID of the sales rep who signed them up
  commissionRate Float? // Commission rate for this sales rep

  customer                    Customer?
  accounts                    Account[]
  sessions                    Session[]
  dogs                        Dog[]
  serviceVisits               ServiceVisit[]
  dataReadings                DataReading[]
  referrals                   User[]                 @relation("SalesRepReferrals")
  salesRep                    User?                  @relation("SalesRepReferrals", fields: [salesRepId], references: [id])
  earnedCommissions           Commission[]           @relation("CommissionSalesRep")
  receivedCommissions         Commission[]           @relation("CommissionCustomer")
  orgId                       String?
  org                         Org?                   @relation(fields: [orgId], references: [id])
  assignedLeads               Lead[]                 @relation("LeadSalesRep")
  territoryAssignments        TerritoryAssignment[]
  createdLeads                Lead[]                 @relation("LeadCreator")
  ownedLeads                  Lead[]                 @relation("LeadOwner")
  leadActivities              LeadActivity[]
  tripsCreated                Trip[]                 @relation("TripCreator")
  tripsOwned                  Trip[]                 @relation("TripOwner")
  prospectImports             ProspectImport[]       @relation("ProspectImportUploader")
  assignedServiceVisits       ServiceVisit[]         @relation("AssignedServiceVisits")
  routes                      Route[]                @relation("RouteTechnician")
  technicianRouteInstances    RouteInstance[]        @relation("RouteInstanceTechnician")
  dispatchedRouteInstances    RouteInstance[]        @relation("RouteInstanceDispatcher")
  technicianRouteStops        RouteStop[]            @relation("RouteStopTechnician")
  scooperProfile              ScooperProfile?
  mediaReviews                ServiceVisitMedia[]   @relation("ServiceVisitMediaReviewer")
  visitReviewsAuthored        ServiceVisitReview[]  @relation("ServiceVisitReviewer")
  dailyCheckReviews           ScooperDailyCheck[]   @relation("DailyCheckReviewer")
  dailyCheckSubmissions       ScooperDailyCheck[]   @relation("ScooperDailyCheckOwner")
  issuedScooperCertifications ScooperCertification[] @relation("ScooperCertificationIssuer")
  visitOffers                 VisitOffer[]           @relation("VisitOfferOfferedTo")
  backupServiceVisits         ServiceVisit[]         @relation("BackupServiceVisits")
  routeShiftAssignments       RouteShift[]           @relation("RouteShiftScooper")
  createdRouteShifts          RouteShift[]           @relation("RouteShiftCreator")
  visitPayouts                VisitPayout[]          @relation("VisitPayoutScooper")
  ledgerEntries               ScooperLedgerEntry[]   @relation("LedgerEntryScooper")
  recordedLedgerEntries       ScooperLedgerEntry[]   @relation("LedgerEntryRecorder")
  qaAudits                    ScooperQaAudit[]       @relation("VisitQaAuditor")
  scooperRewardRedemptions    ScooperRewardRedemption[] @relation("ScooperRewardScooper")
  scooperRewardEvents         ScooperRewardEvent[]   @relation("ScooperRewardEvents")
  primaryJobs                 Job[]                  @relation("JobPrimaryScooper")
  disciplineEventsCreated     ScooperDisciplineEvent[] @relation("DisciplineEventCreator")
  withdrawalRequests          ScooperWithdrawalRequest[] @relation("ScooperWithdrawalScooper")
  withdrawalReviews           ScooperWithdrawalRequest[] @relation("ScooperWithdrawalReviewer")
  pushTokens                  UserPushToken[]
  householdMemberships        HouseholdMember[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPushToken {
  id         String   @id @default(cuid())
  userId     String
  orgId      String?
  provider   String   @default("EXPO")
  token      String   @unique
  platform   String?
  deviceId   String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  disabledAt DateTime?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org?  @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orgId])
}

// Dog profiles
model Dog {
  id        String   @id @default(cuid())
  name      String
  breed     String?
  age       Int?
  weight    Float?
  allergies String?
  medications String?
  dietNotes String?
  vetName   String?
  vetPhone  String?
  vetClinic String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insurancePhone        String?
  photoUrl  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataReadings DataReading[]
  orgId        String?
  org          Org?          @relation(fields: [orgId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  samples      Sample[]
  weeklyWellnessReports WeeklyWellnessReport[]
  wellnessCaptures CustomerWellnessCapture[]
  wellnessChatLogs CustomerWellnessChatLog[]
  wellnessMemories CustomerWellnessMemory[]
  wellnessEmbeddings CustomerWellnessEmbedding[]
  wellnessDailyCheckIns CustomerWellnessDailyCheckIn[]
  wellnessReminders CustomerWellnessReminder[]
  wellnessWalks CustomerWellnessWalk[]
  foodLogs CustomerFoodLog[]
  foodProducts CustomerFoodProduct[]
  foodSchedules CustomerFoodSchedule[]
  weightEntries DogWeightEntry[]
  vetDocuments CustomerVetDocument[]
}

// Service visits
model ServiceVisit {
  id                      String        @id @default(cuid())
  userId                  String?
  orgId                   String?
  customerId              String?
  jobId                   String?
  assignedToId            String? // Field tech assigned
  backupAssignedToId      String?
  scheduledDate           DateTime
  completedDate           DateTime?
  actualStart             DateTime?
  actualEnd               DateTime?
  status                  ServiceStatus @default(SCHEDULED)
  serviceType             ServiceType
  yardSize                YardSize
  dogsServiced            Int
  accountNumber           String? // For linking Raspberry Pi data
  skipReasonId            String?
  notes                   String?
  deodorize               Boolean       @default(false)
  litterService           Boolean       @default(false)
  autoGenerated           Boolean       @default(false)
  revenueCents            Int?
  tileId                  String?
  routeShiftId            String?
  requiredCertifications  Json?
  scheduledEnd            DateTime?
  metadata                Json?
  preferredTimeWindow     String?
  preferredTimeWindowSlug String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user             User?                @relation(fields: [userId], references: [id])
  customer         Customer?            @relation(fields: [customerId], references: [id])
  job              Job?                 @relation(fields: [jobId], references: [id])
  assignedTo       User?                @relation("AssignedServiceVisits", fields: [assignedToId], references: [id])
  backupAssignedTo User?                @relation("BackupServiceVisits", fields: [backupAssignedToId], references: [id])
  dataReadings     DataReading[]
  commissions      Commission[]
  media            ServiceVisitMedia[]
  sampleInsights   ServiceVisitSampleInsight[]
  insights         VisitInsight[]
  communications   VisitCommunication[]
  routeStop        RouteStop?
  tile             ServiceTile?         @relation(fields: [tileId], references: [id])
  routeShift       RouteShift?          @relation("RouteShiftVisits", fields: [routeShiftId], references: [id])
  visitOffers      VisitOffer[]
  visitPayout      VisitPayout?         @relation("ServiceVisitPayout")
  qaAudit          ScooperQaAudit?      @relation("ServiceVisitQaAudit")
  review           ServiceVisitReview?
  rating           ServiceVisitRating?
  disciplineEvents ScooperDisciplineEvent[]
  ledgerEntries    ScooperLedgerEntry[]
  billingEntries   CustomerBillingLedgerEntry[] @relation("ServiceVisitBillingLedger")
  scooperRewardEvents ScooperRewardEvent[]

  @@index([orgId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([backupAssignedToId])
  @@index([scheduledDate])
  @@index([tileId])
  @@index([routeShiftId])
}

// Data readings from Raspberry Pi
model DataReading {
  id             String   @id @default(cuid())
  userId         String?
  dogId          String?
  serviceVisitId String?
  timestamp      DateTime @default(now())
  weight         Float? // Waste weight in grams
  volume         Float? // Waste volume in ml
  color          String? // Color analysis (RGB values)
  consistency    String? // Texture/consistency analysis
  temperature    Float? // Temperature reading
  methaneLevel   Float? // Methane sensor reading
  location       String? // GPS coordinates if mobile
  deviceId       String // Raspberry Pi device identifier
  accountNumber  String? // For anonymous data collection

  user         User?         @relation(fields: [userId], references: [id])
  dog          Dog?          @relation(fields: [dogId], references: [id])
  serviceVisit ServiceVisit? @relation(fields: [serviceVisitId], references: [id])
}

// Global eco statistics
model GlobalStats {
  id                  String   @id @default("global")
  totalWasteDiverted  Float    @default(0) // in lbs
  totalMethaneAvoided Float    @default(0) // in ft³
  totalUsers          Int      @default(0)
  totalDogs           Int      @default(0)
  totalServiceVisits  Int      @default(0)
  updatedAt           DateTime @updatedAt
}

// Commission tracking for sales reps
model Commission {
  id             String           @id @default(cuid())
  salesRepId     String // Sales rep who earned the commission
  customerId     String // Customer who generated the commission
  serviceVisitId String // Service visit that generated commission
  amount         Float // Commission amount
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  salesRep     User         @relation("CommissionSalesRep", fields: [salesRepId], references: [id])
  customer     User         @relation("CommissionCustomer", fields: [customerId], references: [id])
  serviceVisit ServiceVisit @relation(fields: [serviceVisitId], references: [id])

  @@unique([salesRepId, serviceVisitId])
}

// Enums
enum UserRole {
  CUSTOMER
  SALES_REP
  ADMIN
  TECH
  OWNER
}

enum WellnessTier {
  FREE
  PREMIUM
}

enum WellnessPlanStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum WellnessPlanSource {
  DIRECT
  SERVICE_PROMO
  ADMIN
}

enum WellnessEmbeddingSource {
  DOG_PROFILE
  WEEKLY_REPORT
  DAILY_CHECK_IN
  OWNER_CAPTURE
  PRO_CAPTURE
  FOOD_PRODUCT
  FOOD_LOG
  REMINDER
  CHAT_LOG
}

enum CustomerEmailReportCadence {
  WEEKLY
  MONTHLY
}

enum WellnessReminderCategory {
  MEDS
  VACCINE
  DEWORMING
  FLEA_TICK
  FOOD_TRANSITION
  VET_VISIT
  CUSTOM
}

enum WellnessDailyLevel {
  LOW
  NORMAL
  HIGH
  UNKNOWN
}

enum FoodLogType {
  FOOD
  TREAT
  SUPPLEMENT
  MEDICATION
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SKIPPED
}

enum ServiceType {
  REGULAR
  ONE_TIME
  SPRING_CLEANUP
  DEODORIZATION
}

enum YardSize {
  SMALL // < 1/4 acre
  MEDIUM // 1/4 - 1/2 acre
  LARGE // 1/2 - 1 acre
  XLARGE // > 1 acre
}

// ====================
// Multi-tenant & Edge → Cloud pipeline models
// ====================

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  devices               Device[]
  jobs                  Job[]
  dogs                  Dog[]
  samples               Sample[]
  alerts                Alert[]
  leads                 Lead[]
  businessConfig        BusinessConfig?
  territories           Territory[]
  territoryAssignments  TerritoryAssignment[]
  leadActivities        LeadActivity[]
  cadences              Cadence[]
  cadenceEnrollments    LeadCadenceEnrollment[]
  trips                 Trip[]
  prospectImports       ProspectImport[]
  serviceTiles          ServiceTile[]
  tileMetricSnapshots   TileMetricSnapshot[]
  scooperProfiles       ScooperProfile[]
  scooperCertifications ScooperCertification[]
  scooperAvailabilities ScooperAvailability[]
  scooperDevices        ScooperDevice[]
  routeShifts           RouteShift[]
  visitCompSchedules    VisitCompSchedule[]
  visitPayouts          VisitPayout[]
  scooperWithdrawalRequests ScooperWithdrawalRequest[] @relation("OrgScooperWithdrawalRequests")
  visitOffers           VisitOffer[]
  scooperLedgerEntries  ScooperLedgerEntry[]
  scooperQaAudits       ScooperQaAudit[]
  serviceVisitReviews   ServiceVisitReview[]
  scooperDailyChecks       ScooperDailyCheck[]
  weeklyWellnessReports    WeeklyWellnessReport[]
  scooperRewardItems       ScooperRewardItem[]
  scooperRewardRedemptions ScooperRewardRedemption[]
  scooperRewardEvents      ScooperRewardEvent[]
  customerRewardItems       CustomerRewardItem[]
  customerRewardRedemptions CustomerRewardRedemption[]
  customerRewardEvents      CustomerRewardEvent[]
  scooperDisciplineEvents  ScooperDisciplineEvent[]
  pushTokens               UserPushToken[]
  serviceVisitRatings      ServiceVisitRating[]
  customerWellnessPlans    CustomerWellnessPlan[]
  customerWellnessUsage    CustomerWellnessUsage[]
  customerWellnessCaptures CustomerWellnessCapture[]
  customerWellnessDailyCheckIns CustomerWellnessDailyCheckIn[]
  customerWellnessReminders     CustomerWellnessReminder[]
  customerWellnessChatLogs      CustomerWellnessChatLog[]
  customerWellnessMemories      CustomerWellnessMemory[]
  customerWellnessEmbeddings    CustomerWellnessEmbedding[]
  customerWellnessWalks         CustomerWellnessWalk[]
  customerEmailReportPreferences CustomerEmailReportPreference[]
  customerFoodLogs         CustomerFoodLog[]
  customerFoodProducts     CustomerFoodProduct[]
  customerFoodSchedules    CustomerFoodSchedule[]
  dogWeightEntries         DogWeightEntry[]
  customerVetDocuments     CustomerVetDocument[]

  // unique on slug already declared at field level
}

model BusinessConfig {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Business metadata
  businessName String @default("Business")

  // Service area configuration
  serviceZones Json // Array of service zones with ZIP codes

  // Pricing configuration
  basePricing Json // Base pricing tiers, frequencies, add-ons

  // Business settings
  settings Json // Business-specific settings

  // Operational settings
  operations Json // Operational configuration

  // Communication settings
  communication Json // Communication preferences

  // Integration settings (optional)
  integrations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                      String   @id @default(cuid())
  userId                  String?  @unique
  user                    User?    @relation(fields: [userId], references: [id])
  orgId                   String
  org                     Org      @relation(fields: [orgId], references: [id])
  name                    String
  email                   String?
  phone                   String?
  addressLine1            String
  city                    String
  state                   String
  zip                     String
  latitude                Float?
  longitude               Float?
  preferredTimeWindow     String?
  preferredTimeWindowSlug String?
  notes                   String?
  shareWellnessNotes      Boolean  @default(true)
  shareWellnessCaptures   Boolean  @default(true)
  autoBlurWellnessPhotos  Boolean  @default(true)
  parasiteRiskNotificationsEnabled Boolean @default(true)
  parasiteRiskLastNotifiedAt DateTime?
  createdAt               DateTime @default(now())

  dogs          Dog[]
  dogWeightEntries DogWeightEntry[]
  jobs          Job[]
  samples       Sample[]
  leads         Lead[]
  serviceVisits ServiceVisit[]
  visitRatings  ServiceVisitRating[]
  weeklyWellnessReports WeeklyWellnessReport[]
  wellnessPlans  CustomerWellnessPlan[]
  wellnessUsage  CustomerWellnessUsage[]
  wellnessCaptures CustomerWellnessCapture[]
  wellnessChatLogs CustomerWellnessChatLog[]
  wellnessMemories CustomerWellnessMemory[]
  wellnessEmbeddings CustomerWellnessEmbedding[]
  wellnessDailyCheckIns CustomerWellnessDailyCheckIn[]
  wellnessReminders CustomerWellnessReminder[]
  wellnessWalks CustomerWellnessWalk[]
  rewardRedemptions CustomerRewardRedemption[]
  rewardEvents CustomerRewardEvent[]
  emailReportPreference CustomerEmailReportPreference?
  foodLogs      CustomerFoodLog[]
  foodProducts CustomerFoodProduct[]
  foodSchedules CustomerFoodSchedule[]
  billingPlans  CustomerBillingPlan[]       @relation("CustomerBillingPlans")
  billingLedger CustomerBillingLedgerEntry[] @relation("CustomerBillingLedger")
  householdMembers HouseholdMember[]
  vetDocuments CustomerVetDocument[]
}

// Household member / temporary access for dog sitters, family members, etc.
model HouseholdMember {
  id           String                @id @default(cuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId       String?               // Linked user account if they've signed up
  user         User?                 @relation(fields: [userId], references: [id])
  name         String
  email        String
  role         HouseholdMemberRole   @default(FAMILY_MEMBER)
  status       HouseholdMemberStatus @default(PENDING)
  inviteToken  String?               @unique
  expiresAt    DateTime?             // Null = permanent, otherwise temporary access
  lastAccessAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([customerId, email])
  @@index([customerId])
  @@index([userId])
  @@index([inviteToken])
}

enum HouseholdMemberRole {
  FAMILY_MEMBER    // Lives in household, permanent access
  DOG_SITTER       // Temporary caretaker
  DOG_WALKER       // Regular walker
  HOUSE_SITTER     // Temporary while owner is away
  EMERGENCY_CONTACT // Can view but limited actions
}

enum HouseholdMemberStatus {
  PENDING   // Invite sent, not yet accepted
  ACTIVE    // Accepted and has access
  EXPIRED   // Access period ended
  REVOKED   // Manually removed by owner
}

model CustomerWellnessPlan {
  id                   String             @id @default(cuid())
  orgId                String
  customerId           String
  tier                 WellnessTier       @default(FREE)
  status               WellnessPlanStatus @default(ACTIVE)
  source               WellnessPlanSource @default(DIRECT)
  stripeSubscriptionId String?
  revenueCatAppUserId  String?
  revenueCatOriginalAppUserId String?
  revenueCatEntitlementId String?
  revenueCatProductId  String?
  revenueCatStore      String?
  startedAt            DateTime           @default(now())
  endsAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([customerId])
  @@index([status, endsAt])
  @@index([revenueCatAppUserId])
}

model CustomerWellnessUsage {
  id         String   @id @default(cuid())
  orgId      String
  customerId String
  periodKey  String
  scansCount Int      @default(0)
  chatsCount Int      @default(0)
  foodScansCount Int  @default(0)
  inventoryAddsCount Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, periodKey])
  @@index([orgId])
}

model CustomerWellnessCapture {
  id               String              @id @default(cuid())
  orgId            String
  customerId       String
  dogId            String?
  suspectedDogIds  String[]            @default([])
  scope            WellnessReportScope @default(HOUSEHOLD)
  attribution      WellnessAttribution @default(HOUSEHOLD)
  symptomTags      String[]            @default([])
  notes            String?
  gpsLat           Float?
  gpsLng           Float?
  gpsAccuracy      Float?
  capturedAt       DateTime            @default(now())
  storagePath      String
  consentToShare   Boolean             @default(true)
  analysisStatus   MediaAnalysisStatus @default(PENDING)
  analysisResult   Json?
  analysisModel    String?
  analysisConfidence Float?
  analysisError    String?
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog      Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  weeklyWellnessReportCaptures WeeklyWellnessReportCapture[]

  @@index([customerId, capturedAt])
  @@index([orgId, capturedAt])
  @@index([dogId])
}

model CustomerWellnessDailyCheckIn {
  id            String              @id @default(cuid())
  orgId         String
  customerId    String
  dogId         String?
  suspectedDogIds String[]          @default([])
  loggedAt      DateTime            @default(now())
  appetite      WellnessDailyLevel?
  energy        WellnessDailyLevel?
  waterIntake   WellnessDailyLevel?
  stoolFrequency Int?
  vomiting      Boolean             @default(false)
  diarrhea      Boolean             @default(false)
  medsGiven     Boolean             @default(false)
  medsNotes     String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog      Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  weeklyWellnessReportCheckIns WeeklyWellnessReportDailyCheckIn[]

  @@index([customerId, loggedAt])
  @@index([orgId, loggedAt])
  @@index([dogId])
}

model CustomerWellnessReminder {
  id              String                     @id @default(cuid())
  orgId           String
  customerId      String
  dogId           String?
  title           String
  category        WellnessReminderCategory   @default(CUSTOM)
  notes           String?
  nextDueAt       DateTime
  frequencyDays   Int?
  active          Boolean                    @default(true)
  lastCompletedAt DateTime?
  lastNotifiedAt  DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog      Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)

  @@index([customerId, nextDueAt])
  @@index([orgId, nextDueAt])
  @@index([dogId])
}

model CustomerWellnessWalk {
  id              String   @id @default(cuid())
  orgId           String
  customerId      String
  dogId           String?
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  distanceMeters  Float
  path            Json
  metadata        Json?
  createdAt       DateTime @default(now())

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog      Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)

  @@index([customerId, startedAt])
  @@index([orgId, startedAt])
  @@index([dogId])
}

model CustomerFoodLog {
  id              String      @id @default(cuid())
  orgId           String
  customerId      String
  dogId           String?
  productId       String?
  loggedAt        DateTime    @default(now())
  type            FoodLogType @default(FOOD)
  brand           String?
  productName     String?
  ingredients     String?
  portion         String?
  allergenMatches String[]    @default([])
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog      Dog?     @relation(fields: [dogId], references: [id], onDelete: SetNull)
  product  CustomerFoodProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([customerId, loggedAt])
  @@index([orgId, loggedAt])
  @@index([dogId])
  @@index([productId])
}

model CustomerFoodProduct {
  id          String      @id @default(cuid())
  orgId       String
  customerId  String
  dogId       String?
  type        FoodLogType @default(FOOD)
  brand       String?
  productName String?
