  availabilities             ScooperAvailability[]
  devices                    ScooperDevice[]
  routeShifts                RouteShift[]
  visitPayouts               VisitPayout[]
  routePlans                 ScooperRoutePlan[]
  scooperRewardRedemptions   ScooperRewardRedemption[]
  visitRatings               ServiceVisitRating[]
  disciplineEvents           ScooperDisciplineEvent[]

  @@index([orgId])
}

model ScooperDisciplineEvent {
  id             String                 @id @default(cuid())
  orgId          String
  org            Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scooperId      String
  scooper        ScooperProfile         @relation(fields: [scooperId], references: [id], onDelete: Cascade)
  type           DisciplineEventType
  source         DisciplineEventSource  @default(SYSTEM)
  reason         String?
  serviceVisitId String?
  serviceVisit   ServiceVisit?          @relation(fields: [serviceVisitId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?                  @relation("DisciplineEventCreator", fields: [createdById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([scooperId, createdAt])
  @@index([orgId, createdAt])
  @@index([type, createdAt])
}

model ScooperRoutePlan {
  id          String          @id @default(cuid())
  scooperId   String
  scooper     ScooperProfile  @relation(fields: [scooperId], references: [id], onDelete: Cascade)
  dateKey     DateTime?
  signature   String          @unique
  payload     Json
  summary     Json?
  startLat    Float?
  startLng    Float?
  endLat      Float?
  endLng      Float?
  creditsUsed Int             @default(0)
  expiresAt   DateTime?
  googleRequestHash String?
  validatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([scooperId, dateKey])
  @@index([googleRequestHash])
}

model ScooperCertification {
  id          String              @id @default(cuid())
  orgId       String
  org         Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scooperId   String
  scooper     ScooperProfile      @relation(fields: [scooperId], references: [id], onDelete: Cascade)
  type        CertificationType
  status      CertificationStatus @default(PENDING)
  issuedAt    DateTime?
  expiresAt   DateTime?
  issuedById  String?
  issuedBy    User?               @relation("ScooperCertificationIssuer", fields: [issuedById], references: [id])
  evidenceUrl String?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([scooperId, type])
  @@index([orgId])
  @@index([issuedById])
}

model ScooperAvailability {
  id            String             @id @default(cuid())
  orgId         String
  org           Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scooperId     String
  scooper       ScooperProfile     @relation(fields: [scooperId], references: [id], onDelete: Cascade)
  tileId        String?
  tile          ServiceTile?       @relation(fields: [tileId], references: [id])
  weekday       Int
  window        AvailabilityWindow @default(FULL)
  maxStops      Int?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  notes         String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([orgId])
  @@index([scooperId])
  @@index([tileId])
  @@index([weekday])
}

model ScooperDevice {
  id           String              @id @default(cuid())
  orgId        String
  org          Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scooperId    String
  scooper      ScooperProfile      @relation(fields: [scooperId], references: [id], onDelete: Cascade)
  deviceId     String
  platform     String?
  bluetoothMac String?
  status       ScooperDeviceStatus @default(ACTIVE)
  registeredAt DateTime            @default(now())
  lastSeenAt   DateTime?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([orgId, deviceId])
  @@index([orgId])
  @@index([scooperId])
}

// ======================================
// Marketplace Routing Artifacts
// ======================================

model RouteShift {
  id                String             @id @default(cuid())
  orgId             String
  org               Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tileId            String?
  tile              ServiceTile?       @relation(fields: [tileId], references: [id])
  serviceDate       DateTime
  scheduledWindow   AvailabilityWindow
  status            RouteShiftStatus   @default(PLANNED)
  scooperProfileId  String?
  scooperProfile    ScooperProfile?    @relation(fields: [scooperProfileId], references: [id])
  scooperId         String?
  scooper           User?              @relation("RouteShiftScooper", fields: [scooperId], references: [id])
  backupForShiftId  String?
  backupForShift    RouteShift?        @relation("RouteShiftBackup", fields: [backupForShiftId], references: [id])
  backupShifts      RouteShift[]       @relation("RouteShiftBackup")
  primary           Boolean            @default(false)
  plannedStops      Int                @default(0)
  completedStops    Int                @default(0)
  plannedMiles      Float?
  actualMiles       Float?
  primaryVisitCount Int                @default(0)
  createdById       String?
  createdBy         User?              @relation("RouteShiftCreator", fields: [createdById], references: [id])
  activatedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  notes             String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  serviceVisits ServiceVisit[] @relation("RouteShiftVisits")
  visitOffers   VisitOffer[]
  visitPayouts  VisitPayout[]

  @@index([orgId, serviceDate])
  @@index([tileId])
  @@index([scooperId])
  @@index([status])
}

model VisitOffer {
  id               String           @id @default(cuid())
  orgId            String
  org              Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceVisitId   String
  serviceVisit     ServiceVisit     @relation(fields: [serviceVisitId], references: [id], onDelete: Cascade)
  tileId           String?
  tile             ServiceTile?     @relation(fields: [tileId], references: [id])
  routeShiftId     String?
  routeShift       RouteShift?      @relation(fields: [routeShiftId], references: [id])
  offeredToId      String?
  offeredTo        User?            @relation("VisitOfferOfferedTo", fields: [offeredToId], references: [id])
  status           VisitOfferStatus @default(PENDING)
  priority         Int              @default(0)
  dispatchStrategy String?
  expiresAt        DateTime?
  respondedAt      DateTime?
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orgId])
  @@index([serviceVisitId])
  @@index([tileId])
  @@index([offeredToId])
  @@index([status])
  @@index([expiresAt])
}

// ======================================
// Compensation & Payouts
// ======================================

model VisitCompSchedule {
  id                     String       @id @default(cuid())
  orgId                  String
  org                    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  frequency              Frequency
  serviceType            ServiceType?
  baseRateCents          Int
  binDropBonusCents      Int          @default(0)
  haulAwayBonusCents     Int          @default(0)
  ecoDiversionBonusCents Int          @default(0)
  addonRates             Json?
  certificationMatrix    Json?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  isDefault              Boolean      @default(false)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  visitPayouts VisitPayout[]

  @@index([orgId])
  @@index([frequency])
  @@index([effectiveFrom])
}

model VisitPayout {
  id                 String             @id @default(cuid())
  orgId              String
  org                Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceVisitId     String             @unique
  serviceVisit       ServiceVisit       @relation("ServiceVisitPayout", fields: [serviceVisitId], references: [id], onDelete: Cascade)
  scooperId          String
  scooper            User               @relation("VisitPayoutScooper", fields: [scooperId], references: [id])
  scooperProfileId   String?
  scooperProfile     ScooperProfile?    @relation(fields: [scooperProfileId], references: [id])
  routeShiftId       String?
  routeShift         RouteShift?        @relation(fields: [routeShiftId], references: [id])
  compScheduleId     String?
  compSchedule       VisitCompSchedule? @relation(fields: [compScheduleId], references: [id])
  status             PayoutStatus       @default(PENDING_REVIEW)
  baseAmountCents    Int                @default(0)
  bonusAmountCents   Int                @default(0)
  mileageAmountCents Int                @default(0)
  ppeAmountCents     Int                @default(0)
  tipsAmountCents    Int                @default(0)
  adjustmentsCents   Int                @default(0)
  totalAmountCents   Int                @default(0)
  milesDriven        Float?
  minutesOnSite      Int?
  qaAuditId          String?            @unique
  qaAudit            ScooperQaAudit?    @relation("PayoutQaAudit", fields: [qaAuditId], references: [id])
  generatedAt        DateTime           @default(now())
  readyAt            DateTime?
  releasedAt         DateTime?
  stripeTransferId   String?
  withdrawalRequestId String?
  withdrawalRequest   ScooperWithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  clearedAt          DateTime?
  cancelledAt        DateTime?
  notes              String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  ledgerEntries ScooperLedgerEntry[]

  @@index([orgId])
  @@index([scooperId])
  @@index([status])
  @@index([readyAt])
  @@index([releasedAt])
  @@index([withdrawalRequestId])
}

model ScooperWithdrawalRequest {
  id            String                  @id @default(cuid())
  orgId         String
  org           Org                     @relation("OrgScooperWithdrawalRequests", fields: [orgId], references: [id], onDelete: Cascade)
  scooperId     String
  scooper       User                    @relation("ScooperWithdrawalScooper", fields: [scooperId], references: [id])
  amountCents   Int
  status        ScooperWithdrawalStatus @default(REQUESTED)
  requestedAt   DateTime                @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?                   @relation("ScooperWithdrawalReviewer", fields: [reviewedById], references: [id])
  paidAt        DateTime?
  stripeTransferId String?
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  payouts VisitPayout[]

  @@index([orgId])
  @@index([scooperId])
  @@index([status])
}

model ScooperLedgerEntry {
  id            String          @id @default(cuid())
  orgId         String
  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scooperId     String
  scooper       User            @relation("LedgerEntryScooper", fields: [scooperId], references: [id])
  payoutId      String?
  payout        VisitPayout?    @relation(fields: [payoutId], references: [id])
  sourceVisitId String?
  serviceVisit  ServiceVisit?   @relation(fields: [sourceVisitId], references: [id])
  type          LedgerEntryType
  amountCents   Int
  notes         String?
  metadata      Json?
  recordedById  String?
  recordedBy    User?           @relation("LedgerEntryRecorder", fields: [recordedById], references: [id])
  recordedAt    DateTime        @default(now())
  clearedAt     DateTime?

  @@index([orgId])
  @@index([scooperId])
  @@index([payoutId])
  @@index([type])
}

model ScooperQaAudit {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceVisitId String       @unique
  serviceVisit   ServiceVisit @relation("ServiceVisitQaAudit", fields: [serviceVisitId], references: [id], onDelete: Cascade)
  auditorId      String?
  auditor        User?        @relation("VisitQaAuditor", fields: [auditorId], references: [id])
  outcome        QaOutcome    @default(PASS)
  score          Int?
  issues         Json?
  resolution     String?
  resolvedAt     DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payout VisitPayout? @relation("PayoutQaAudit")

  @@index([orgId])
  @@index([auditorId])
  @@index([outcome])
}
