    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.11.0",
    "@stripe/react-stripe-js": "^3.9.1",
    "@stripe/stripe-js": "^7.8.0",
    "@supabase/supabase-js": "^2.56.0",
    "@turf/turf": "^7.2.0",
    "@turf/unkink-polygon": "^7.2.0",
