{
  "name": "insightscoop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npx prisma generate && npm run type-check && next build --no-lint && node scripts/postbuild-clean-manifest.js",
    "build:deploy": "npx prisma generate && next build --no-lint && node scripts/postbuild-clean-manifest.js",
    "build:quick": "next build",
    "build:tiles": "tsx scripts/build-tiles.ts",
    "geo:import:hennepin-parcels": "tsx scripts/geo/import-arcgis-parcels.ts --source=hennepin-umn",
    "geo:import:parcels": "tsx scripts/geo/import-parcels.ts",
    "geo:build:metro-counties": "tsx scripts/geo/build-metro-counties.ts",
    "geo:build:county-bboxes": "tsx scripts/geo/build-county-bboxes.ts",
    "geo:discover:parcels": "tsx scripts/geo/discover-arcgis-parcels.ts",
    "db:reset": "npx prisma db push --force-reset",
    "db:seed": "node scripts/seed.js development",
    "db:seed:hennepin": "node scripts/seed-hennepin.js",
    "db:seed:production": "node scripts/seed.js production",
    "db:seed:staging": "node scripts/seed.js staging",
    "db:setup": "npx prisma generate && npx prisma db push",
    "db:setup:full": "npm run db:reset && npm run db:setup && npm run db:seed:hennepin",
    "predev": "npx prisma generate",
    "dev": "next dev",
    "docker:build": "docker build -t yardura-web .",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:dev": "docker-compose -f docker-compose.yml up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f web",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:up": "docker-compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hero:revert": "node update-hero-to-video.js revert",
    "hero:update": "node update-hero-to-video.js",
    "hero:video": "node create-hero-video.js",
    "images:stool-library": "tsx scripts/ai/generate-stool-library-images.ts",
    "images:stool-library:gemini": "tsx scripts/ai/generate-stool-library-images-gemini.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "migrate": "node infra/migration/migrate.js full",
    "migrate:export": "node infra/migration/migrate.js export",
    "migrate:import": "node infra/migration/migrate.js import",
    "migrate:validate": "node infra/migration/migrate.js validate",
    "og:preview": "echo 'Open these URLs in your browser:' && echo 'http://localhost:3000/api/og?type=homepage' && echo 'http://localhost:3000/api/og?type=quote' && echo 'http://localhost:3000/api/og?type=insights&title=Test%20Article' && echo 'http://localhost:3000/api/og?type=facts'",
    "og:test": "curl -s http://localhost:3000/api/og?type=homepage | head -5 && echo '\\n---\\n' && curl -s http://localhost:3000/api/og?type=quote | head -5",
    "perf:analyze": "ANALYZE=true next build",
    "perf:audit": "npm run perf:lh && npm run perf:analyze",
    "perf:lh": "lhci autorun --config=.lighthouserc.json",
    "perf:lh:mobile": "lhci autorun --config=.lighthouserc.json --preset=mobile",
    "setup": "npm run db:setup",
    "start": "next start",
    "test": "vitest",
    "test:dual-db": "node infra/test-dual-db.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:run": "vitest run",
    "test:smoke": "node scripts/smoke-tests.js",
    "test:ui": "vitest --ui",
    "type-check": "npx prisma generate && rm -f tsconfig.tsbuildinfo && tsc --noEmit",
    "vapi:sync": "npx tsx scripts/sync-vapi-assistant.ts",
    "worker": "tsx workers/sampleScorer.ts",
    "jobs:offers": "tsx -r dotenv/config jobs/start-marketplace-offers.ts",
    "jobs:billing": "tsx -r dotenv/config jobs/start-billing-automation.ts",
    "jobs:tile-zips": "tsx jobs/sync-tile-zips.ts",
    "jobs:tiles": "tsx -r dotenv/config jobs/start-tile-generation-worker.ts",
    "jobs:tiles:publish": "tsx -r dotenv/config jobs/start-tile-publish-worker.ts",
    "jobs:outbound-transcription": "tsx -r dotenv/config jobs/start-outbound-transcription-worker.ts",
    "jobs:visit-summary": "tsx -r dotenv/config jobs/start-visit-summary-worker.ts",
    "jobs:media-analysis": "tsx -r dotenv/config jobs/start-media-analysis-worker.ts",
    "jobs:quickbooks": "tsx -r dotenv/config jobs/start-quickbooks-sync.ts",
    "jobs:push-notifications": "tsx -r dotenv/config jobs/start-push-notifications.ts",
    "jobs:customer-reports": "tsx -r dotenv/config jobs/start-customer-email-reports.ts",
    "jobs:visit-generator": "tsx -r dotenv/config jobs/start-visit-generator-worker.ts",
    "jobs:offer-sweeper": "tsx -r dotenv/config jobs/start-marketplace-offer-sweeper.ts",
    "jobs:missed-visits": "tsx -r dotenv/config jobs/start-missed-visit-monitor.ts",
    "jobs:geo-snapshot": "tsx -r dotenv/config jobs/start-geo-snapshot-worker.ts",
    "jobs:route-drafts": "tsx -r dotenv/config jobs/start-route-drafts-worker.ts",
    "jobs:outbound-cadence": "tsx -r dotenv/config jobs/start-outbound-cadence-worker.ts",
    "jobs:outbound-sla": "tsx -r dotenv/config jobs/start-outbound-sla-worker.ts",
    "jobs:wellness-embeddings": "tsx -r dotenv/config jobs/start-wellness-embeddings.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@fastify/websocket": "^11.2.0",
    "@google-cloud/recaptcha-enterprise": "^6.3.0",
    "@hello-pangea/dnd": "^16.6.0",
    "@hookform/resolvers": "^5.2.1",
