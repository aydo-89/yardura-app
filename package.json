    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "openai": "^6.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pmtiles": "^4.3.0",
    "react": "18.2.0",
